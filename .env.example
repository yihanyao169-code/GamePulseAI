# Required: Claude API authentication
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: custom Anthropic-compatible gateway
# Leave empty to use the official Anthropic API endpoint
ANTHROPIC_BASE_URL=

# Optional: default Claude model
CLAUDE_MODEL=claude-sonnet-5

# Optional: override models for different tasks
CLAUDE_CLASSIFY_MODEL=
CLAUDE_SUMMARY_MODEL=

# Optional: analysis concurrency
CLAUDE_MAX_WORKERS=2

# Keep disabled in production
DEBUG_MODE=false
